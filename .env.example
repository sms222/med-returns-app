# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq — free tier, console.groq.com/keys (used for voice transcription + parsing)
VITE_GROQ_API_KEY=your-groq-key

# Optional paid fallback if Groq accuracy isn't enough on drug names
VITE_USE_OPENAI_FALLBACK=false
VITE_OPENAI_API_KEY=
